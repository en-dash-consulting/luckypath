      "input": {
        "file_path": "/Users/nick/development/endash/luckypath/app/components/HowToPlayModal.tsx",
        "content": "import { useEffect, useRef } from \"react\";\n\ninterface HowToPlayModalProps {\n  onClose: () => void;\n}\n\n/**\n * In-game help modal explaining the rules, controls, and scoring system.\n *\n * Accessibility:\n *   - Focus is trapped inside while the modal is open.\n *   - Focus returns to the trigger element on close.\n *   - Escape key dismisses the modal.\n */\nexport function HowToPlayModal({ onClose }: HowToPlayModalProps) {\n  const overlayRef = useRef<HTMLDivElement>(null);\n  const previousFocusRef = useRef<Element | null>(null);\n\n  // Capture the element that had focus before the modal opened, so we can\n  // restore it on close. Also auto-focus the close button on mount.\n  useEffect(() => {\n    previousFocusRef.current = document.activeElement;\n\n    // Focus the first focusable element (the close button)\n    const firstFocusable = overlayRef.current?.querySelector<HTMLElement>(\n      \"button, [href], input, select, textarea, [tabindex]:not([tabindex='-1'])\",\n    );\n    firstFocusable?.focus();\n\n    return () => {\n      // Return focus to the trigger element\n      if (previousFocusRef.current instanceof HTMLElement) {\n        previousFocusRef.current.focus();\n      }\n    };\n  }, []);\n\n  // Escape key dismissal\n  useEffect(() => {\n    function handleKeyDown(e: KeyboardEvent) {\n      if (e.key === \"Escape\") {\n        e.stopPropagation();\n        onClose();\n      }\n    }\n    document.addEventListener(\"keydown\", handleKeyDown);\n    return () => document.removeEventListener(\"keydown\", handleKeyDown);\n  }, [onClose]);\n\n  // Focus trap: keep Tab cycling within the modal\n  useEffect(() => {\n    function handleTab(e: KeyboardEvent) {\n      if (e.key !== \"Tab\") return;\n\n      const overlay = overlayRef.current;\n      if (!overlay) return;\n\n      const focusables = overlay.querySelectorAll<HTMLElement>(\n        \"button, [href], input, select, textarea, [tabindex]:not([tabindex='-1'])\",\n      );\n      if (focusables.length === 0) return;\n\n      const first = focusables[0];\n      const last = focusables[focusables.length - 1];\n\n      if (e.shiftKey && document.activeElement === first) {\n        e.preventDefault();\n        last.focus();\n      } else if (!e.shiftKey && document.activeElement === last) {\n        e.preventDefault();\n        first.focus();\n      }\n    }\n    document.addEventListener(\"keydown\", handleTab);\n    return () => document.removeEventListener(\"keydown\", handleTab);\n  }, []);\n\n  return (\n    <div\n      ref={overlayRef}\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"How to Play\"\n      className=\"fixed inset-0 bg-black/30 backdrop-blur-sm flex items-center justify-center z-50 animate-fadeIn\"\n      onClick={(e) => {\n        // Close on backdrop click (but not on the card itself)\n        if (e.target === e.currentTarget) onClose();\n      }}\n    >\n      <div className=\"bg-white rounded-2xl shadow-2xl max-w-md w-full mx-4 animate-scaleIn max-h-[85dvh] flex flex-col\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between px-6 pt-6 pb-2 shrink-0\">\n          <h2 className=\"text-xl font-bold text-emerald-900\">How to Play</h2>\n          <button\n            onClick={onClose}\n            aria-label=\"Close\"\n            className=\"w-8 h-8 flex items-center justify-center rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors text-lg\"\n          >\n            ✕\n          </button>\n        </div>\n\n        {/* Scrollable content */}\n        <div className=\"overflow-y-auto px-6 pb-6 pt-2 space-y-5\">\n          {/* Section 1: Tile Placement */}\n          <section>\n            <h3 className=\"text-sm font-bold text-emerald-800 uppercase tracking-wider mb-2\">\n              Tile Placement\n            </h3>\n            <div className=\"space-y-2 text-sm text-gray-600 leading-relaxed\">\n              <p>\n                Build a path from Lucky's{\" \"}\n                <span className=\"font-semibold text-emerald-700\">start tile</span>{\" \"}\n                to the{\" \"}\n                <span className=\"font-semibold text-amber-600\">pot of gold</span>{\" \"}\n                using path tiles.\n              </p>\n              <div className=\"flex items-start gap-3\">\n                <TileIcon type=\"straight\" />\n                <p>\n                  <span className=\"font-semibold text-emerald-800\">Straight</span>{\" \"}\n                  — connects two opposite edges in a line.\n                </p>\n              </div>\n              <div className=\"flex items-start gap-3\">\n                <TileIcon type=\"curve\" />\n                <p>\n                  <span className=\"font-semibold text-emerald-800\">Curve</span>{\" \"}\n                  — connects two adjacent edges with a bend.\n                </p>\n              </div>\n              <p>\n                Select a tile type from the inventory, then tap an empty cell on\n                the board to place it.\n              </p>\n            </div>\n          </section>\n\n          {/* Section 2: Rotation Controls */}\n          <section>\n            <h3 className=\"text-sm font-bold text-emerald-800 uppercase tracking-wider mb-2\">\n              Rotation &amp; Editing\n            </h3>\n            <div className=\"space-y-2 text-sm text-gray-600 leading-relaxed\">\n              <p>\n                <span className=\"font-semibold text-emerald-800\">Rotate</span>{\" \"}\n                a placed tile by clicking or tapping it again. Each tap turns it\n                90° clockwise.\n              </p>\n              <p>\n                <span className=\"font-semibold text-emerald-800\">Remove</span>{\" \"}\n                a tile by right-clicking it on desktop, or use the remove tool\n                button in the inventory.\n              </p>\n              <p>\n                <span className=\"font-semibold text-emerald-800\">Drag</span>{\" \"}\n                a tile to move it to a different empty cell.\n              </p>\n            </div>\n          </section>\n\n          {/* Section 3: Par & Clover Scoring */}\n          <section>\n            <h3 className=\"text-sm font-bold text-emerald-800 uppercase tracking-wider mb-2\">\n              Scoring &amp; Clovers\n            </h3>\n            <div className=\"space-y-2 text-sm text-gray-600 leading-relaxed\">\n              <p>\n                When your path is ready, press{\" \"}\n                <span className=\"font-semibold text-emerald-700\">Send Lucky!</span>{\" \"}\n                to watch him walk along it.\n              </p>\n              <p>\n                Each level has a <span className=\"font-semibold text-emerald-800\">par</span>{\" \"}\n                — the target number of tiles. Earn clovers based on how close\n                you get:\n              </p>\n              <div className=\"bg-emerald-50 rounded-xl p-3 space-y-1.5\">\n                <CloverRow count={3} label=\"At or under par\" />\n                <CloverRow count={2} label=\"One over par\" />\n                <CloverRow count={1} label=\"Two or more over par\" />\n              </div>\n              <p>\n                Press <span className=\"font-semibold text-emerald-800\">Retry</span>{\" \"}\n                anytime to clear the board and try again for a better rating.\n              </p>\n            </div>\n          </section>\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-6 pb-5 pt-1 shrink-0\">\n          <button\n            onClick={onClose}\n            className=\"\n              w-full px-5 py-2.5 rounded-xl text-base font-semibold text-emerald-800\n              bg-emerald-50 hover:bg-emerald-100\n              active:scale-95 transition-all\n            \"\n          >\n            Got it!\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n/* ---------- Inline sub-components ---------- */\n\n/** Tiny inline tile icon for the tile-type descriptions. */\nfunction TileIcon({ type }: { type: \"straight\" | \"curve\" }) {\n  const size = 32;\n  const half = size / 2;\n  const pad = 4;\n  return (\n    <svg\n      width={size}\n      height={size}\n      viewBox={`0 0 ${size} ${size}`}\n      className=\"shrink-0 mt-0.5\"\n      aria-hidden=\"true\"\n    >\n      <rect\n        x={1}\n        y={1}\n        width={size - 2}\n        height={size - 2}\n        rx={6}\n        fill=\"#f0fdfa\"\n        stroke=\"#d1d5db\"\n        strokeWidth={1.2}\n      />\n      {type === \"straight\" ? (\n        <line\n          x1={half}\n          y1={pad}\n          x2={half}\n          y2={size - pad}\n          stroke=\"#14b8a6\"\n          strokeWidth={4}\n          strokeLinecap=\"round\"\n        />\n      ) : (\n        <path\n          d={`M${half},${pad} Q${half},${half} ${size - pad},${half}`}\n          fill=\"none\"\n          stroke=\"#14b8a6\"\n          strokeWidth={4}\n          strokeLinecap=\"round\"\n        />\n      )}\n    </svg>\n  );\n}\n\n/** A single row in the clover-scoring table. */\nfunction CloverRow({ count, label }: { count: number; label: string }) {\n  return (\n    <div className=\"flex items-center gap-2\">\n      <div className=\"flex gap-1\">\n        {[1, 2, 3].map((i) => (\n          <div\n            key={i}\n            className={`w-5 h-5 rounded-full flex items-center justify-center ${\n              i <= count ? \"bg-emerald-400\" : \"bg-gray-100\"\n            }`}\n          >\n            <svg width=\"10\" height=\"10\" viewBox=\"0 0 14 14\" aria-hidden=\"true\">\n              <circle cx=\"4\" cy=\"4.5\" r=\"2.8\" fill={i <= count ? \"white\" : \"#d1d5db\"} />\n              <circle cx=\"10\" cy=\"4.5\" r=\"2.8\" fill={i <= count ? \"white\" : \"#d1d5db\"} />\n              <circle cx=\"7\" cy=\"2.5\" r=\"2.8\" fill={i <= count ? \"white\" : \"#d1d5db\"} />\n              <line\n                x1=\"7\"\n                y1=\"6\"\n                x2=\"7.5\"\n                y2=\"12\"\n                stroke={i <= count ? \"white\" : \"#d1d5db\"}\n                strokeWidth=\"1.2\"\n                strokeLinecap=\"round\"\n              />\n            </svg>\n          </div>\n        ))}\n      </div>\n      <span className=\"text-xs text-gray-600 font-medium\">{label}</span>\n    </div>\n  );\n}\n"
      },
      "output": "",
      "durationMs": 0
    },
